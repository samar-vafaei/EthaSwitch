--- re_grp file
CREATE VIEW cc.re_group AS
        WITH dr_rules AS (
                SELECT cc.services.gateway_group_id AS groupid, 
                        CONCAT(cc.services.tech_prefix,cc.master_prefixes.prefix) AS reg_exp, 
                                                        cc.route_groups.dial_plan_id								
                FROM cc.routes
                JOIN cc.gateways
                ON cc.routes.gateway_group_id = cc.gateways.gateway_group_id
                JOIN cc.route_groups
                ON cc.routes.id = cc.route_groups.route_id
                JOIN cc.dial_plans
                ON cc.dial_plans.id = cc.route_groups.dial_plan_id
                JOIN cc.dial_plan_groups
                ON cc.dial_plan_groups.dial_plan_id = cc.dial_plans.id
                JOIN cc.services
                ON cc.services.id = cc.dial_plan_groups.service_id
                JOIN cc.master_prefixes
                ON cc.master_prefixes.id = cc.dial_plan_groups.master_prefix_id
                WHERE cc.dial_plans.blocked = 'no' 
                ORDER BY groupid,prefix,priority
        ), tbl_temp_1 AS (
                SELECT row_number() over() AS setid, cc.services.gateway_group_id AS groupid, cc.route_groups.dial_plan_id				
                FROM cc.routes
                JOIN cc.gateways
                ON cc.routes.gateway_group_id = cc.gateways.gateway_group_id
                JOIN cc.route_groups
                ON cc.routes.id = cc.route_groups.route_id
                JOIN cc.dial_plans
                ON cc.dial_plans.id = cc.route_groups.dial_plan_id
                JOIN cc.dial_plan_groups
                ON cc.dial_plan_groups.dial_plan_id = cc.dial_plans.id
                JOIN cc.services
                ON cc.services.id = cc.dial_plan_groups.service_id
                JOIN cc.master_prefixes
                ON cc.master_prefixes.id = cc.dial_plan_groups.master_prefix_id
                WHERE cc.dial_plans.blocked = 'no' 
                GROUP BY groupid, cc.route_groups.dial_plan_id
                ORDER BY setid
        )
        SELECT DISTINCT dr_rules.reg_exp, tbl_temp_1.setid AS group_id
        FROM dr_rules
        JOIN tbl_temp_1
        ON tbl_temp_1.groupid = dr_rules.groupid AND tbl_temp_1.dial_plan_id = dr_rules.dial_plan_id
        ORDER BY setid
