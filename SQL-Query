
--- dr_groups table
INSERT INTO dr.dr_groups (username,domain,groupid,description)
	SELECT services.tech_prefix AS username,
    gateways.ip_address AS domain,
    gateways.gateway_group_id AS groupid,
    ''::text AS description
   FROM cc.gateways
   JOIN cc.services 
   ON gateways.gateway_group_id = services.gateway_group_id;


--- dr_gateways table
INSERT INTO dr.dr_gateways (gwid,type,address,strip,pri_prefix,attrs,description)    
	SELECT gateways.id,
    2 AS type,
    gateways.ip_address AS address,
    4 AS strip,
    routes.tech_prefix AS pri_prefix,
    ''::text AS attrs,
    ''::text AS description
   FROM cc.gateways
     JOIN cc.routes 
	 ON gateways.gateway_group_id = routes.gateway_group_id;


--- dr_rules table
INSERT INTO dr.dr_rules (groupid, prefix, timerec, priority, routeid, gwlist, description) 
    (SELECT groupid, prefix, ''::text AS timerec, 0 AS priority, 0 AS routeid, string_agg(gwid::text, ',') AS gwlist , ''::text AS description
        FROM (SELECT cc.services.gateway_group_id AS groupid, cc.master_prefixes.prefix, cc.gateways.id AS gwid	
                FROM cc.routes
                JOIN cc.gateways
                ON cc.routes.gateway_group_id = cc.gateways.gateway_group_id
                JOIN cc.route_groups
                ON cc.routes.id = cc.route_groups.route_id
                JOIN cc.dial_plans
                ON cc.dial_plans.id = cc.route_groups.dial_plan_id
                JOIN cc.dial_plan_groups
                ON cc.dial_plan_groups.dial_plan_id = cc.dial_plans.id
                JOIN cc.services
                ON cc.services.id = cc.dial_plan_groups.service_id
                JOIN cc.master_prefixes
                ON cc.master_prefixes.id = cc.dial_plan_groups.master_prefix_id
                WHERE cc.dial_plans.blocked = 'no' 
                ORDER BY groupid,prefix,priority) AS dr_rules
    GROUP BY groupid,prefix)


INSERT INTO dr.dr_rules (groupid, prefix, timerec, priority, routeid, gwlist, description) 
    (SELECT groupid, prefix, ''::text AS timerec, 0 AS priority, 0 AS routeid, string_agg(gwid::text, ',') AS gwlist , ''::text AS description
        FROM (SELECT cc.services.gateway_group_id AS groupid, CONCAT(cc.services.tech_prefix,cc.master_prefixes.prefix) AS prefix, cc.gateways.id AS gwid	
                FROM cc.routes
                JOIN cc.gateways
                ON cc.routes.gateway_group_id = cc.gateways.gateway_group_id
                JOIN cc.route_groups
                ON cc.routes.id = cc.route_groups.route_id
                JOIN cc.dial_plans
                ON cc.dial_plans.id = cc.route_groups.dial_plan_id
                JOIN cc.dial_plan_groups
                ON cc.dial_plan_groups.dial_plan_id = cc.dial_plans.id
                JOIN cc.services
                ON cc.services.id = cc.dial_plan_groups.service_id
                JOIN cc.master_prefixes
                ON cc.master_prefixes.id = cc.dial_plan_groups.master_prefix_id
                WHERE cc.dial_plans.blocked = 'no' 
                ORDER BY groupid,prefix,priority) AS dr_rules
    GROUP BY groupid,prefix)



select cc.routes.id as routeid,cc.gateways.id as gwid,cc.gateways.ip_address,cc.routes.tech_prefix, 
	   cc.route_groups.dial_plan_id,cc.route_groups.priority,cc.route_groups.weight,
	   cc.dial_plans.routing_model,cc.dial_plans.blocked,
	   cc.dial_plan_groups.service_id,cc.dial_plan_groups.master_prefix_id,
	   cc.services.gateway_group_id as groupid, cc.master_prefixes.prefix
from cc.routes
join cc.gateways
on cc.routes.gateway_group_id=cc.gateways.gateway_group_id
join cc.route_groups
on cc.routes.id=cc.route_groups.route_id
join cc.dial_plans
on cc.dial_plans.id=cc.route_groups.dial_plan_id
join cc.dial_plan_groups
on cc.dial_plan_groups.dial_plan_id=cc.dial_plans.id
join cc.services
on cc.services.id=cc.dial_plan_groups.service_id
join cc.master_prefixes
on cc.master_prefixes.id=cc.dial_plan_groups.master_prefix_id
where cc.dial_plans.blocked='no'
order by groupid,prefix


