--- re_grp file
CREATE VIEW cc.re_group AS
        WITH dr_rules AS (
                        SELECT cc.services.gateway_group_id AS groupid, cc.services.tech_prefix AS tech_prefix, 
                                        CONCAT(cc.services.tech_prefix,cc.master_prefixes.prefix) AS prefix, cc.gateways.id AS gwid
                        FROM cc.routes
                        JOIN cc.gateways
                        ON cc.routes.gateway_group_id = cc.gateways.gateway_group_id
                        JOIN cc.route_groups
                        ON cc.routes.id = cc.route_groups.route_id
                        JOIN cc.dial_plans
                        ON cc.dial_plans.id = cc.route_groups.dial_plan_id
                        JOIN cc.dial_plan_groups
                        ON cc.dial_plan_groups.dial_plan_id = cc.dial_plans.id
                        JOIN cc.services
                        ON cc.services.id = cc.dial_plan_groups.service_id
                        JOIN cc.master_prefixes
                        ON cc.master_prefixes.id = cc.dial_plan_groups.master_prefix_id
                        WHERE cc.dial_plans.blocked = 'no' 
                        ORDER BY groupid,prefix,priority
        )
        SELECT DISTINCT SA.reg_exp, VA.setid FROM
                (SELECT tech_prefix, STRING_AGG(gwid::TEXT, ',') AS gwlist, SUM(gwid) AS gwid_sum, prefix AS reg_exp, 
                        LENGTH(tech_prefix) AS strip	
                FROM dr_rules
                GROUP BY groupid, prefix, tech_prefix
                ORDER BY tech_prefix) AS SA
                JOIN (SELECT row_number() OVER() AS setid, strip, gwlist, gwid_sum From
                        (SELECT prefix AS reg_exp, STRING_AGG(gwid::TEXT, ',') AS gwlist, SUM(gwid) AS gwid_sum, 
                                groupid, tech_prefix, LENGTH(tech_prefix) AS strip, 8 AS flags, 0 AS priority,
                                ''::TEXT AS attributes        
                        FROM dr_rules
                        GROUP BY groupid, tech_prefix, prefix) AS tt
                        GROUP BY gwid_sum, strip, gwlist
                        ORDER BY strip DESC) AS VA
                ON SA.gwid_sum = VA.gwid_sum AND SA.strip = VA.strip
                ORDER BY SA.reg_exp;


--- dispatcher file
CREATE VIEW cc.dispatcher AS
        WITH dr_rules AS (
                        SELECT cc.services.gateway_group_id AS groupid, cc.services.tech_prefix AS tech_prefix, 
                                        CONCAT(cc.services.tech_prefix,cc.master_prefixes.prefix) AS prefix, cc.gateways.id AS gwid
                        FROM cc.routes
                        JOIN cc.gateways
                        ON cc.routes.gateway_group_id = cc.gateways.gateway_group_id
                        JOIN cc.route_groups
                        ON cc.routes.id = cc.route_groups.route_id
                        JOIN cc.dial_plans
                        ON cc.dial_plans.id = cc.route_groups.dial_plan_id
                        JOIN cc.dial_plan_groups
                        ON cc.dial_plan_groups.dial_plan_id = cc.dial_plans.id
                        JOIN cc.services
                        ON cc.services.id = cc.dial_plan_groups.service_id
                        JOIN cc.master_prefixes
                        ON cc.master_prefixes.id = cc.dial_plan_groups.master_prefix_id
                        WHERE cc.dial_plans.blocked = 'no' 
                        ORDER BY groupid,prefix,priority
        ), tbl_temp_1 AS (
                SELECT gateways.id AS duid,   
                                lower(gateways.protocol) || ':'::TEXT || gateways.ip_address || ':'::TEXT || gateways.port AS destination,		
                                8 AS flags, 0 AS priority,
                                'duid='::TEXT || gateways.id || ';'::TEXT || 'maxload='::TEXT || gateways.capacity || ';'::TEXT || 'prefix='::TEXT || routes.tech_prefix AS attributes 
                FROM cc.gateways
                JOIN cc.routes 
        ON gateways.gateway_group_id = routes.gateway_group_id
        ORDER BY duid
        )
        SELECT setid, destination, flags, priority , attributes || ';'::TEXT || 'strip='::TEXT || strip AS attributes  
        FROM (SELECT setid, gwset, strip 
                FROM (SELECT row_number() over() AS setid, strip, gwlist
                        FROM (SELECT prefix AS reg_exp ,STRING_AGG(gwid::TEXT, ',') AS gwlist, SUM(gwid) AS gwid_sum, 
                                groupid, tech_prefix, LENGTH(tech_prefix) AS strip 
                                FROM dr_rules
                                GROUP BY groupid, tech_prefix, prefix) AS tt
                        GROUP BY gwid_sum, strip, gwlist
                        ORDER BY strip DESC) AS tbl , unnest(string_to_array(gwlist, ',')) gwset) AS tbl_temp_2
        JOIN tbl_temp_1
        ON tbl_temp_1.duid = NULLIF(tbl_temp_2.gwset,'')::int;





